<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATH" value="logs"/>

    <property name="AUDIT_PATTERN"
              value="[%d{HH:mm:ss}] [%level]: %msg%n"/>

    <appender name="WEBSOCKET"
              class="com.letraaletra.api.shared.infrastructure.audit.WebSocketAppender"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{10}: %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ADMIN AUDIT -->
    <appender name="AUDIT_ADMIN_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/admin/latest.log</file>
        <encoder>
            <pattern>${AUDIT_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/admin/%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- GAME AUDIT (Dinâmico via MDC) -->
    <appender name="AUDIT_GAME_SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
            <key>gameLogPath</key>
            <defaultValue>untracked/general.log</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${gameLogPath}" class="ch.qos.logback.core.FileAppender">
                <file>${LOG_PATH}/game/${gameLogPath}</file>
                <encoder>
                    <pattern>${AUDIT_PATTERN}</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- LOGGERS -->
    <logger name="AUDIT_ADMIN" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_ADMIN_FILE"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="WEBSOCKET"/>
    </logger>

    <logger name="AUDIT_GAME" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_GAME_SIFT"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

</configuration>